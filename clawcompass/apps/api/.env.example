# Server
PORT=3000
NODE_ENV=development
STORE_PATH=./data/clawcompass-store.json

# GOAT Network public config
GOAT_CHAIN_ID=2345
GOAT_RPC_URL=https://rpc.goat.network
ERC8004_REGISTRY_ADDRESS=0x8004A169FB4a3325136EB29fA0ceB6D2e539a432
ERC8004_AGENT_ID=
ERC8004_AGENT_URI=

# Public addresses and non-secret IDs
AGENT_WALLET_ADDRESS=
CLAWUP_AGENT_ID=
GOAT_RECEIVING_WALLET=

# Secrets supplied only in local runtime or ClawUp UI, never committed
AGENT_PRIVATE_KEY=
TELEGRAM_BOT_TOKEN=
GOATX402_API_URL=
GOATX402_API_KEY=
GOATX402_API_SECRET=
GOATX402_MERCHANT_ID=

# Policy
DEFAULT_SPENDING_CAP_USD=0.10
HARD_SPENDING_STOP_USD=1.00
MAX_PAID_EXECUTIONS_PER_SESSION=3

# Local tests/development only. Final demo must use real x402 verification.
ENABLE_MOCK_X402=false
